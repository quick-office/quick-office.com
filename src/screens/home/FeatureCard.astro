---
import SparkleIcon from '@/components/icons/SparkleIcon.astro';

interface Props {
    icon: any;
    title: string;
    is_starred: boolean;
}

const { icon: Icon, title, is_starred } = Astro.props;
---

<div class="p-8 xl:px-10 xl:py-11 border-t border-l border-text-light/5 relative">
    <Icon class="mb-6 mx-auto text-primary" />
    <h3 class="text-h5-sm font-bold mb-4 text-center">{title}</h3>
    <p class="text-center">Visualize how teams are staffed & what resources are available across.</p>
    {
        [
            'top-0 left-0 -translate-x-1/2 -translate-y-1/2',
            'top-0 right-0 translate-x-1/2 -translate-y-1/2',
            'bottom-0 left-0 -translate-x-1/2 translate-y-1/2',
            'bottom-0 right-0 translate-x-1/2 translate-y-1/2',
        ].map((pos) => <SparkleIcon data-is-starred={String(is_starred)} class={`absolute z-10 ${pos} hidden`} />)
    }
</div>
