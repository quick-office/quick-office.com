---
import { platformAbleton, platformAirbnb, platformFacebook, platformFigma, platformSlack } from '@/lib/assets';
import { siteName, basicPrice } from '@/lib/config';

import { Section } from '@/components/ui/section';
import { Container } from '@/components/ui/container';

import ImageMod from '@/components/elements/ImageMod.astro';

const items = [
    {
        title: 'Tally + Excel + Separate Payroll',
        price: '৳8,000+',
        images: [platformAbleton, platformAirbnb],
        highlight: false,
    },
    {
        title: 'Enterprise Accounting Suite',
        price: '৳15,000+',
        images: [platformFacebook, platformFigma],
        highlight: false,
    },
    {
        title: `${siteName} — All-in-One`,
        price: basicPrice,
        images: [platformSlack],
        highlight: true,
    },
];

const competitors = items.filter((i) => !i.highlight);
const featured = items.find((i) => i.highlight)!;
---

<Section class="relative isolate overflow-x-hidden">
    <div class="absolute inset-0 -z-20 pointer-events-none bg-body"></div>
    <div
        class="absolute inset-0 -z-10 pointer-events-none opacity-25"
        style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='10' height='10' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 10L10 0M-2.5 2.5L2.5 -2.5M7.5 12.5L12.5 7.5' stroke='%23b8c6d6' stroke-width='1'/%3E%3C/svg%3E&quot;); background-size: 10px 10px;"
    >
    </div>
    <div
        class="absolute inset-0 -z-10 pointer-events-none bg-linear-to-b from-transparent via-primary/8 to-transparent"
    >
    </div>

    <Container>
        <div class="flex flex-col gap-10 lg:gap-16">
            <div class="flex flex-col items-center gap-y-5 text-center">
                <h2 class="mx-auto mb-2 text-h3 lg:col-10 lg:text-h2 [&_strong]:text-primary">
                    One Tool. <strong>Replace Them All.</strong>
                </h2>
            </div>

            <div class="flex flex-col gap-3 px-4">
                {
                    competitors.map(({ title, price, images }) => (
                        <div class="relative rounded-2xl border border-border bg-body/50 py-5 px-6 corner-squircle">
                            <div class="flex flex-col items-center gap-6 lg:flex-row lg:justify-between">
                                <div class="bg-body border border-border px-4 py-2.5 rounded-full flex items-center justify-center gap-x-2 w-full max-w-70 relative z-10">
                                    <span class="font-semibold text-text-dark text-lg">{title}</span>
                                </div>
                                <div class="flex items-center justify-start gap-3 xl:gap-5 lg:min-w-90 relative z-10">
                                    {images.map((src) => (
                                        <ImageMod src={src} alt={`${title} icon`} class="max-h-12" />
                                    ))}
                                </div>
                                <div class="bg-body border border-border px-4 py-2.5 rounded-full flex items-center justify-center gap-x-2 w-full max-w-60 relative z-10">
                                    <span class="font-normal text-text text-base">
                                        <span class="text-secondary font-secondary font-bold text-h6">{price}</span>{' '}
                                        /Per Month
                                    </span>
                                </div>
                            </div>
                            <div class="absolute inset-0 items-center -z-10 hidden xl:flex">
                                <div class="border-t border-dashed border-border w-full" />
                            </div>
                        </div>
                    ))
                }

                <div class="flex items-center gap-4 px-2 my-1">
                    <div class="flex-1 border-t border-dashed border-border/60"></div>
                    <span class="text-xs font-bold text-text-light uppercase tracking-widest">vs</span>
                    <div class="flex-1 border-t border-dashed border-border/60"></div>
                </div>

                <div class="relative rounded-2xl border-2 border-primary bg-primary/5 py-5 px-6 corner-squircle">
                    <div class="flex flex-col items-center gap-6 lg:flex-row lg:justify-between">
                        <div
                            class="bg-body border-2 border-primary px-4 py-2.5 rounded-full flex items-center justify-center gap-x-2 w-full max-w-70 relative z-10"
                        >
                            <span class="font-semibold text-primary text-lg">{featured.title}</span>
                        </div>
                        <div class="flex items-center justify-start gap-3 xl:gap-5 lg:min-w-90 relative z-10">
                            {
                                featured.images.map((src) => (
                                    <ImageMod src={src} alt={`${featured.title} icon`} class="max-h-12" />
                                ))
                            }
                        </div>
                        <div
                            class="bg-body border-2 border-primary px-4 py-2.5 rounded-full flex items-center justify-center gap-x-2 w-full max-w-60 relative z-10"
                        >
                            <span class="font-normal text-text text-base">
                                <span class="text-primary font-secondary font-bold text-h6">{featured.price}</span>{' '}
                                /Per Month
                            </span>
                        </div>
                    </div>
                    <div class="absolute inset-0 items-center -z-10 hidden xl:flex">
                        <div class="border-t border-dashed border-primary/30 w-full"></div>
                    </div>
                </div>
            </div>
        </div>
    </Container>
</Section>
