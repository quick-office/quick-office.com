---
import {
    valuesIcon1,
    valuesIcon2,
    valuesIcon3,
    featuredVideoThumbnail as howItWorksPoster,
    bannerShowcaseVideo as video,
} from '@/lib/assets';

import { Button } from '@/components/ui/button';
import { Section } from '@/components/ui/section';
import { Container } from '@/components/ui/container';

import OvalBgIcon from '@/components/icons/OvalBgIcon.astro';
import ProcessCard from './ProcessCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import { registerLink } from '@/lib/config';

const steps = [
    {
        logo: valuesIcon1,
        title: '1. Start Your Free Trial',
        content: 'Sign up in seconds — no credit card required. Your account is ready immediately.',
    },
    {
        logo: valuesIcon2,
        title: '2. Set Up in Minutes',
        content:
            'Add your company, chart of accounts, customers, and suppliers. Most teams send their first invoice within the hour.',
    },
    {
        logo: valuesIcon3,
        title: '3. Run Your Finances Daily',
        content: 'Create invoices, record vouchers, process payments, and pull reports — all from one dashboard.',
    },
];
---

<Section
    variant="box"
    id="how-it-works"
    class="max-lg:overflow-hidden pb-16 xl:pb-19 bg-transparent relative isolate overflow-hidden"
>
    <div class="absolute inset-0 -z-20 pointer-events-none bg-body"></div>
    <div
        class="absolute inset-0 -z-10 pointer-events-none opacity-30"
        style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='48' height='20' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 10 Q12 2 24 10 Q36 18 48 10' stroke='%23c7d2e0' stroke-width='1' fill='none'/%3E%3C/svg%3E&quot;); background-size: 48px 20px;"
    >
    </div>
    <div
        class="absolute inset-0 -z-10 pointer-events-none bg-linear-to-l from-primary/10 via-transparent to-transparent"
    >
    </div>
    <Container>
        <div class="flex flex-col gap-10 lg:gap-16">
            <div class="flex flex-col items-center gap-y-5 text-center">
                <h2 class="mx-auto mb-2 text-h3 lg:col-10 lg:text-h2 [&_strong]:text-primary">
                    Up and Running in <strong class="italic">3 Simple Steps</strong>
                </h2>
            </div>
            <div class="mb-0">
                <div class="mb-14">
                    <TestimonialCard poster={howItWorksPoster} video={video} />
                </div>
                <div class="grid lg:grid-cols-2 xl:grid-cols-3 gap-8 xl:gap-16">
                    {steps.map((step) => <ProcessCard logo={step.logo} title={step.title} content={step.content} />)}
                </div>
                <div class="flex justify-center mt-10 xl:mt-18">
                    <Button href={registerLink}>Start My Free Trial</Button>
                </div>
            </div>
        </div>
    </Container>
    <div class="absolute inset-x-0 top-0 -z-10">
        <OvalBgIcon class="w-full" />
    </div>
</Section>
