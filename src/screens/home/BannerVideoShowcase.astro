---
// Hero Video Showcase
// - Autoplay muted + loop
// - GSAP scroll animation: starts tilted/scaled, normalizes on scroll (handled by animations.js)
// - Click button → unmute video, hide overlay button
// - Click again → mute, show overlay

import { bannerShowcaseVideo as video } from '@/lib/assets';
import PlayIcon from '@/components/icons/PlayIcon.astro';
---

<div class="relative w-full max-w-280 mx-auto rounded-4xl overflow-hidden" data-gsap-video-showcase>
    <video
        id="videoPlayer"
        class="w-full aspect-video object-cover"
        autoplay
        muted
        loop
        width="1000px"
        playsinline
        preload="metadata"
    >
        <source src={video} type="video/mp4" />
        Your browser does not support the video tag.
    </video>
    <!-- Sound toggle overlay — visible = muted (shows icon to unmute) -->
    <button
        id="soundToggle"
        class="absolute inset-0 grid place-items-center shadow-lg bg-black/30 cursor-pointer transition-opacity duration-300"
        aria-label="Unmute video"
    >
        <div id="mutedIcon" class="bg-black/90 rounded-full size-24 grid place-items-center relative">
            <!-- Spinning ring -->
            <div
                class="inset-0 scale-90 transition-transform duration-300 size-full absolute rounded-full border-2 border-solid border-t-transparent border-b-transparent border-primary animate-spin"
                style="animation-duration: 3s;"
            >
            </div>
            <!-- Play icon -->
            <PlayIcon class="size-9" />
        </div>
    </button>
</div>
<!-- Note: sound toggle JS is handled in main.js via [data-gsap-video-showcase] selector -->
