---
import type { ImageMetadata } from 'astro';

import { iconSparkle } from '@/lib/assets';

import ImageMod from '@/components/ImageMod.astro';

interface Props {
    logo: ImageMetadata | string;
    title: string;
    list?: string[];
}

const { logo, title, list } = Astro.props;
---

<div class="p-8 rounded-2xl bg-black/5">
    <div class="mb-6 size-14 rounded-xl bg-primary flex items-center justify-center p-3">
        <ImageMod src={logo} alt={`${title} icon`} />
    </div>
    <h3 class="text-h5-sm font-bold">{title}</h3>
    <ul class="list-none pl-0 mt-5 text-text-dark">
        {
            list?.map((item) => (
                <li class="relative mb-3 pl-6">
                    <ImageMod
                        src={iconSparkle}
                        alt=""
                        class="absolute left-0 top-0 mt-0.5 size-4 translate-y-1"
                        aria-hidden="true"
                    />
                    {item}
                </li>
            ))
        }
    </ul>
</div>
