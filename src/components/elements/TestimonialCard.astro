---
import type { ImageMetadata } from 'astro';

import PlayIcon from '@/components/icons/PlayIcon.astro';

interface Props {
    poster: ImageMetadata | string;
    content?: string;
    name?: string;
    designation?: string;
    video?: string;
}

const { poster, content, name, designation, video } = Astro.props;

const posterSrc = typeof poster === 'object' ? poster.src : poster;
---

<div>
    <div
        data-testimonial-video
        class="relative w-full max-w-280 mx-auto rounded-[30px] corner-squircle overflow-hidden"
    >
        <video
            class="w-full aspect-video object-cover"
            width="1000px"
            playsinline
            preload="metadata"
            poster={posterSrc}
        >
            <source src={video} type="video/mp4" />
            Your browser does not support the video tag.
        </video>
        {
            video && (
                <button
                    class="absolute inset-0 grid place-items-center shadow-lg group bg-black/30 cursor-pointer"
                    aria-label="Resume"
                >
                    <div class="transition-all duration-300 group-hover:scale-125 bg-black/90 hover:bg-white rounded-full size-24 grid place-items-center relative">
                        <div
                            class="inset-0 scale-90 transition-transform duration-300 size-full absolute rounded-full border-2 border-solid border-t-transparent border-b-transparent border-primary animate-spin"
                            style="animation-duration: 8s;"
                        />
                        <PlayIcon class="size-9" />
                    </div>
                </button>
            )
        }
    </div>
    <div class="p-7 rounded-[30px] mt-2.5 corner-squircle bg-light/60">
        <p class="text-text-light text-h6 text-center">
            {content}
        </p>
        <hr class="opacity-20 my-10" />
        <div class="text-center">
            <p class="text-text-light font-semibold">{name}</p>
            <p class="text-text-dark/60 text-sm">{designation}</p>
        </div>
    </div>
</div>
