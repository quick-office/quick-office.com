---
import GradientBlob from '@/components/GradientBlob.astro';
import PricingCard from '@/components/elements/PricingCard.astro';

export const pricingData = {
    page_header: {
        badge: 'Pricing',
        title: 'Pricing Built For Local Business Growth',
        content: 'Start your free 14-day trial, scale as you grow. No contracts. Cancel anytime.',
    },
    comparison: {
        enable: true,
        badge: 'Plan Matrix',
        title: 'Pricing Plans <strong>Comparison</strong>',
        headers: [{ label: 'Features' }, { label: 'Basic' }, { label: 'Pro' }],
        rows: [
            { feature: 'Monthly Price', values: ['৳1,999', '৳4,999'] },
            { feature: 'Invoice Creation & Management', values: [true, true] },
            { feature: 'Payment Receive History', values: [true, true] },
            { feature: 'Supplier Invoice Management', values: [true, true] },
            { feature: 'Chart of Accounts', values: [true, true] },
            { feature: 'Voucher Creation (Debit/Credit)', values: [true, true] },
            { feature: 'Profit & Loss Reports', values: [true, true] },
            { feature: 'Cost Center Analysis', values: [false, true] },
            { feature: 'Account Distribution Overview', values: [false, true] },
            { feature: 'Journal Book & Account Book', values: [false, true] },
            { feature: 'Team Members', values: ['Up to 5', 'Up to 20'] },
            { feature: 'SSLCommerz Payments', values: [false, true] },
            { feature: 'Support', values: ['Email Support', 'Priority Support'] },
        ],
    },
};

export const plans = [
    {
        title: 'Basic',
        price: '1,999',
        yearly_price: '19,990',
        is_featured: false,
        description: 'Full accounting for small businesses and growing teams.',
        button: { enable: true, label: 'Start Free Trial', link: '/pricing' },
        features: [
            { label: 'Invoice Creation & Management', included: true },
            { label: 'Payment Receive History', included: true },
            { label: 'Supplier Invoice Management', included: true },
            { label: 'Chart of Accounts', included: true },
            { label: 'Voucher Creation (Debit/Credit)', included: true },
            { label: 'Profit & Loss Reports', included: true },
            { label: 'Cost Center Analysis', included: false },
            { label: 'Team Roles & Permissions', included: true },
            { label: 'Up to 5 Team Members', included: true },
        ],
    },
    {
        title: 'Pro',
        price: '4,999',
        yearly_price: '49,990',
        is_featured: true,
        offer_text: 'Most Popular',
        description: 'Advanced reporting and multi-user access for scaling businesses.',
        button: { enable: true, label: 'Start Free Trial', link: '/pricing' },
        features: [
            { label: 'Everything in Basic', included: true },
            { label: 'Cost Center Analysis', included: true },
            { label: 'Account Distribution Overview', included: true },
            { label: 'Journal Book & Account Book', included: true },
            { label: 'Up to 20 Team Members', included: true },
            { label: 'Priority Support', included: true },
            { label: 'SSLCommerz Payments', included: true },
        ],
    },
];
---

<div class="relative">
    <div class="price-togger">
        <input type="checkbox" data-pricing-toggle id="pricing-toggle" class="hidden" />
        <label for="pricing-toggle" class="price-toggler-btn active">Monthly</label>
        <label for="pricing-toggle" class="price-toggler-btn">Yearly</label>
    </div>
    <div class="grid md:grid-cols-2 gap-7 relative z-10">
        {
            plans.map((plan) => (
                <PricingCard
                    price={plan.price}
                    yearly_price={plan.yearly_price}
                    title={plan.title}
                    is_featured={plan.is_featured}
                    offer_text={plan.offer_text}
                    button={plan.button}
                    description={plan.description}
                    features={plan.features}
                />
            ))
        }
    </div>
    <GradientBlob />
</div>
