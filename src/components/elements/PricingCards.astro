---
import {
    registerLink,
    basicPrice,
    basicYearlyPrice,
    professionalPrice,
    professionalYearlyPrice,
    enterprisePrice,
    enterpriseYearlyPrice,
} from '@/lib/config';

import GradientBlob from '@/components/GradientBlob.astro';
import PricingCard from '@/components/elements/PricingCard.astro';

export const plans = [
    {
        title: 'Basic',
        price: basicPrice,
        yearly_price: basicYearlyPrice,
        is_featured: false,
        offer_text: '',
        description: 'All features included for small teams.',
        button: { enable: true, label: 'Upgrade to Basic', link: `${registerLink}?plan=basic` },
        features: [
            { label: '3 users', included: true },
            { label: '30-day billing cycle', included: true },
            { label: 'All features included', included: true },
        ],
    },
    {
        title: 'Professional',
        price: professionalPrice,
        yearly_price: professionalYearlyPrice,
        is_featured: true,
        offer_text: 'Most Popular',
        description: 'All features included for growing businesses.',
        button: { enable: true, label: 'Upgrade to Professional', link: `${registerLink}?plan=professional` },
        features: [
            { label: '10 users', included: true },
            { label: '30-day billing cycle', included: true },
            { label: 'All features included', included: true },
        ],
    },
    {
        title: 'Enterprise',
        price: enterprisePrice,
        yearly_price: enterpriseYearlyPrice,
        is_featured: false,
        offer_text: '',
        description: 'All features included for large teams.',
        button: { enable: true, label: 'Upgrade to Enterprise', link: `${registerLink}?plan=enterprise` },
        features: [
            { label: 'Unlimited users', included: true },
            { label: '30-day billing cycle', included: true },
            { label: 'All features included', included: true },
        ],
    },
];
---

<div class="relative">
    <div class="price-togger">
        <input type="checkbox" data-pricing-toggle id="pricing-toggle" class="hidden" />
        <label for="pricing-toggle" class="price-toggler-btn active">Monthly</label>
        <label for="pricing-toggle" class="price-toggler-btn">
            Yearly <span class="discount-badge font-semibold">-20%</span>
        </label>
    </div>
    <div class="grid md:grid-cols-3 gap-7 relative z-10">
        {
            plans.map((plan) => (
                <PricingCard
                    price={plan.price}
                    yearly_price={plan.yearly_price}
                    title={plan.title}
                    is_featured={plan.is_featured}
                    offer_text={plan.offer_text}
                    button={plan.button}
                    description={plan.description}
                    features={plan.features}
                />
            ))
        }
    </div>
    <GradientBlob />
</div>
