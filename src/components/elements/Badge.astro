---
import BadgeStarsIcon from '@/components/icons/BadgeStarsIcon.astro';

interface Props {
    title?: string;
}
const { title } = Astro.props;
---

{
    title && (
        <div class="flex bg-white text-dark font-medium max-w-max px-4 py-1.5 text-sm rounded-xl items-center gap-x-2 badge">
            <BadgeStarsIcon class="badge-stars" />
            <span>{title}</span>
        </div>
    )
}
