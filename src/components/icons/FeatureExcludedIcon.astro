---
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'svg'>;
const { class: className, ...rest } = Astro.props;
---

<svg {...rest} class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect opacity="0.2" width="24" height="24" rx="6" fill="var(--color-text-light)" />
    <rect x="18" y="11" width="2" height="12" rx="1" transform="rotate(90 18 11)" fill="white" fill-opacity="0.4" />
</svg>
