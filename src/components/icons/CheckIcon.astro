---
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'svg'>;
const { class: className, ...rest } = Astro.props;
---

<svg {...rest} class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <polyline points="20 6 9 17 4 12" />
</svg>
