---
import { PricingCheckout } from './PricingCheckout';
import FeatureIncludedIcon from '@/components/icons/FeatureIncludedIcon.astro';
import FeatureExcludedIcon from '@/components/icons/FeatureExcludedIcon.astro';
import InfoIcon from '@/components/icons/InfoIcon.astro';

interface Feature {
    label: string;
    included: boolean;
    tooltip?: string;
}
interface Props {
    price: string;
    yearly_price: string;
    title: string;
    is_featured?: boolean;
    offer_text?: string;
    button: { enable: boolean; label: string; link: string };
    description?: string;
    features?: Feature[];
}
const { price, yearly_price, title, is_featured = false, offer_text, button, description, features } = Astro.props;
---

<div class={`py-10 px-7 rounded-3xl text-left relative ${is_featured ? 'bg-light/50 overflow-hidden' : 'bg-light/80'}`}>
    {
        is_featured && (
            <>
                <div class="absolute bottom-0 right-0 translate-y-1/2 translate-x-1/2 grid place-items-center -z-10" />
                <div class="absolute top-10 right-5 transform bg-primary text-white text-xs font-semibold py-1.5 px-3 rounded-lg">
                    {offer_text ?? 'Most Popular'}
                </div>
            </>
        )
    }

    <div class="mb-10 leading-none relative">
        <span class="text-text-dark text-h3 font-semibold price-tag opacity-0">I</span>
        <span class="text-text-dark text-h3 font-semibold price-tag absolute left-0 top-0" data-price-tag-monthly>
            {price}
            <span class="ml-1 text-sm text-text transition-all duration-300">/ Per Month</span>
        </span>
        <span
            class="text-text-dark text-h3 font-semibold price-tag opacity-0 absolute left-0 top-0"
            data-price-tag-yearly
        >
            {yearly_price}
            <span class="ml-0.5 text-sm text-text transition-all duration-300">/ Per Year</span>
        </span>
    </div>

    <h3 class="text-h6 text-text-dark mb-5">{title}</h3>
    <p class="text-text-dark">{description}</p>

    {
        button.enable && (
            <PricingCheckout client:load link={button.link} buttonLabel={button.label} isFeatured={is_featured} />
        )
    }

    <div class="text-text-dark font-bold mb-6">Features Included</div>

    <ul class="space-y-4">
        {
            (features || []).map((f) => (
                <li class="flex items-start gap-x-4">
                    {f.included ? <FeatureIncludedIcon /> : <FeatureExcludedIcon />}
                    <span>{f.label}</span>
                    {f.tooltip && (
                        <div class="relative group">
                            <InfoIcon class="mt-1 group-hover:text-primary text-text-dark transition-colors duration-150" />
                            <div class="absolute bottom-full right-0 bg-text-light/5 backdrop-blur-lg py-2 px-3 rounded-lg hidden group-hover:block w-40 lg:w-75 text-sm text-text-dark shadow-lg translate-x-1/2">
                                {f.tooltip}
                            </div>
                        </div>
                    )}
                </li>
            ))
        }
    </ul>
</div>
